<?xml version="1.0" encoding="utf-8"?>
<!--
  Davranışsal EDR'nin erişilebilirlik yapılandırması.
  Yalnızca pencere-durumu değişimleri dinlenir; pencere içeriği alınmaz
  (canRetrieveWindowContent=false) — karar paket+sınıf adıyla verilir.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/edr_accessibility_description"
    android:eventTypes="typeWindowStateChanged"
    android:feedbackType="feedbackGeneric"
    android:notificationTimeout="100"
    android:canRetrieveWindowContent="false" />

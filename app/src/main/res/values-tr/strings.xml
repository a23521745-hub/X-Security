    <string name="protection_title">Koruma</string>
    <string name="protection_hint">X-Security’nin cihazı nasıl izleyeceğini seçin. Hiçbir modda veri cihazdan çıkmaz.</string>
    <string name="protection_mode_always">Her zaman açık</string>
    <string name="protection_mode_always_desc">Kalıcı servis: İndirilenler klasörünü yeni APK’lar için izler ve her kurulumu tarar.</string>
    <string name="protection_mode_install_only">Sadece kurulum anı</string>

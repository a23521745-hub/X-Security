    <string name="autopilot_permissions_title">Optional access and onboarding</string>
    <string name="autopilot_permissions_hint">Each setting is optional. Without Usage Access the 15-minute polling fallback is unavailable; enabled Accessibility can still report foreground package changes. If overlay is denied, a full-screen warning is used.</string>
    <string name="autopilot_permission_battery">Battery exemption</string>
    <string name="autopilot_permission_battery_desc">May improve the reliability of scheduled checks; WorkManager still applies system limits.</string>
    <string name="autopilot_permission_overlay">Warning overlay</string>
    <string name="autopilot_permission_overlay_desc">Shows Go Back, Uninstall, and Open Anyway (24h) actions over a warning. Denial falls back to a full-screen activity.</string>
    <string name="autopilot_permission_usage">Usage Access</string>
    <string name="autopilot_permission_usage_desc">Usage Access enables a 15-minute foreground polling fallback. Opt-in Accessibility can report window-state package changes immediately. Launch warnings check active quarantine or known-bad verdicts only; v17 does not scan every launch.</string>
    <string name="autopilot_permission_accessibility">Quarantine assist</string>
    <string name="autopilot_permission_accessibility_desc">When enabled, reports package-only foreground changes; during an explicit quarantine assist it may help find the system Force stop control. Screen content is never stored or logged.</string>
    <string name="autopilot_permission_granted">Enabled</string>
    <string name="autopilot_permission_missing">Optional</string>
    <string name="autopilot_permission_open">Review setting</string>
    <string name="autopilot_rationale_battery_title">Why battery exemption?</string>
    <string name="autopilot_rationale_battery_body">This optional system setting can reduce delays to scheduled security checks. X-Security still uses WorkManager and does not keep a hidden always-on service.</string>
    <string name="autopilot_rationale_overlay_title">Why an overlay?</string>
    <string name="autopilot_rationale_overlay_body">A warning overlay can show Allow for 24 hours and the system Uninstall confirmation. If you decline, X-Security opens a full-screen warning instead.</string>
    <string name="autopilot_rationale_usage_title">Why Usage Access?</string>
    <string name="autopilot_rationale_usage_body">Usage Access provides only the foreground package identifier as a 15-minute fallback. Opt-in Accessibility can report package-only window changes immediately. Launch warnings check active quarantine or known-bad verdicts only; v17 does not scan every launch.</string>
    <string name="autopilot_rationale_accessibility_title">Why quarantine accessibility?</string>
    <string name="autopilot_rationale_accessibility_body">After a quarantine action, the optional helper inspects only the system app-details screen to attempt Force stop. It stores no screen content. OEM differences may result in a visible FAILED state.</string>
    <string name="quarantine_accessibility_label">X-Security quarantine assist</string>
    <string name="quarantine_accessibility_description">Reports package-only foreground changes. Only during a requested quarantine assist, helps operate the system Force stop control in app details. It does not collect, store, or log screen content.</string>
    <string name="quarantine_title">Quarantine history</string>
    <string name="quarantine_hint">Encrypted copies and verdict metadata stay on this device. A file counts as quarantined only once its original has been removed after your tap; until then its card says the original is still on the device. Restoring, deleting or uninstalling always requires an explicit user action.</string>
